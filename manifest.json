{
  "manifest_version": 3,
  "name": "MarkLens — Instant Markdown Renderer & Page Converter",
  "version": "1.2.0",
  "description": "Select Markdown on any page for a live preview — popup, side panel, or fullscreen overlay. Preview GitHub/Bitbucket PRs too.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.bitbucket.org/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "MarkLens — Instant Markdown Renderer & Page Converter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    { "resources": ["css/highlight.css", "css/highlight-dark.css", "icons/favicon.png", "sidepanel.html"], "matches": ["<all_urls>"] }
  ]
}
